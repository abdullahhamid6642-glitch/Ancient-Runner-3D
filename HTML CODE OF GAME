 const sec=secAt(Math.floor((dist+80)/SL));if(sec!=lastSec){lastSec=sec;if(dist>5)bn(MP.nm[sec])}
 $('co').textContent='◆ '+coins;$('sc').textContent=Math.floor(dist)+' m'}
function anim(dt,rdt){
 ph+=dt*(9+spd*.22)+(mn?rdt*9:0);spin=mn?spin+rdt*.9:spin*(1-Math.min(1,rdt*8));P.rotation.y=spin;slideA+=((slideT>0&&py<.3?1:0)-slideA)*Math.min(1,dt*16);const s=Math.sin(ph),air=py>.05;
 P.position.set(px,.95*(1-slideA)+.36*slideA+py,0);P.traverse(o=>{if(o.material&&'opacity' in o.material){o.material.transparent=true;o.material.opacity=power=='invis'?.22:1}});P.rotation.z=(px-lane*2.2)*-.06;body.rotation.x=slideA*1.5;
 const mv=air?0:1-slideA*.9;legs[0].rotation.x=air?-.7:s*.9*mv;legs[1].rotation.x=air?.5:-s*.9*mv;
 arms[0].rotation.x=air?-1.2:-s*.8*mv-slideA*2.6;arms[1].rotation.x=air?-1.2:s*.8*mv-slideA*2.6;
 scarf.position.y=.98+Math.sin(ph*.8)*.06;scarf.rotation.x=Math.sin(ph)*.2+(air?.4:0);
 body.position.y=air||slideA>.5?0:Math.abs(s)*.08;
 shadow.position.set(px,.03,0);shadow.scale.setScalar(1-Math.min(py,2)*.25);
 for(const g of groups)for(const f of g.f)if(f.visible)f.fl.scale.setScalar(1+Math.sin(t*14+g.idx)*.25);
 for(let i=parts.length-1;i>=0;i--){const p=parts[i];p.m.position.addScaledVector(p.v,dt);p.v.y-=12*dt;p.l-=dt;p.m.scale.setScalar(Math.max(.01,p.l*2));if(p.l<=0){sc.remove(p.m);parts.splice(i,1)}}
 for(const k in CC)CC[k].lerp(TC[k],.03);sun.color.copy(CC.sun);roadMat.color.copy(CC.road);mossMat.color.copy(CC.road).lerp(MC,.55);wallMat.color.copy(CC.road).multiplyScalar(.72);capMat.color.copy(CC.road).multiplyScalar(1.05);pilMat.color.copy(CC.road).multiplyScalar(.88);waterMat.color.copy(CC.water);GEM.forEach((g,i)=>{g.mat.color.setHSL(g.h+.04*Math.sin(t*1.5+i),g.s,g.l);g.mat.emissive.setHSL(g.h+.05*Math.sin(t*2+i),.9,.16+.1*Math.sin(t*6+i*2))});
 const fov=65+Math.min(18,(spd-26)*.5);if(Math.abs(cam.fov-fov)>.1){cam.fov+=(fov-cam.fov)*.05;cam.updateProjectionMatrix()}
