const dc=document.createElement('canvas');dc.width=dc.height=64;{const x=dc.getContext('2d'),g=x.createRadialGradient(32,32,0,32,32,32);g.addColorStop(0,'#fff');g.addColorStop(.25,'rgba(255,255,255,.35)');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,64,64);x.fillStyle='#fff';x.beginPath();x.moveTo(32,0);x.lineTo(36,28);x.lineTo(64,32);x.lineTo(36,36);x.lineTo(32,64);x.lineTo(28,36);x.lineTo(0,32);x.lineTo(28,28);x.fill()}

const stx=new T.CanvasTexture(dc),HC=(h,s,l)=>new T.Color().setHSL(h,s,l);

const GEM=[[.52,.85,.66],[.88,.8,.72],[.58,.35,.9]].map(([h,s,l])=>({h,s,l,mat:new T.MeshPhongMaterial({flatShading:true,side:T.DoubleSide,specular:0xffffff,shininess:150}),gl:new T.MeshBasicMaterial({color:HC(h,.9,.55),transparent:true,opacity:.25,blending:T.AdditiveBlending,depthWrite:false}),st:new T.SpriteMaterial({map:stx,color:HC(h,.6,.8),transparent:true,blending:T.AdditiveBlending,depthWrite:false}),sk:new T.MeshBasicMaterial({color:HC(h,.9,.7)})}));

function addTok(l,z,h,i,v){const G=GEM[v||0],m=new T.Group(),g=mk(gs.gem,G.mat),o=mk(gs.glow,G.gl),s=new T.Sprite(G.st);o.position.z=-.2;s.position.z=.35;m.add(g,o,s);m.position.set(l*2.2,.9+h,z);sc.add(m);toks.push({m,g,s,ph:i+v*2,x:l*2.2,v:G})}
const PWR=[{id:'fly',ic:'🪽',name:'FLIGHT',col:0x7ee8ff,dur:10},{id:'invis',ic:'👻',name:'INVISIBLE',col:0xdca7ff,dur:12},{id:'jump',ic:'⬆',name:'LONG JUMP',col:0xffd05a,dur:12}];
function addPower(l,z,i){const q=PWR[i%PWR.length],m=new T.Group(),core=mk(new T.OctahedronGeometry(.68,0),new T.MeshPhongMaterial({color:q.col,emissive:q.col,emissiveIntensity:.35,transparent:true,opacity:.95})),ring=mk(new T.TorusGeometry(.95,.075,8,28),new T.MeshBasicMaterial({color:q.col,transparent:true,opacity:.8}));ring.rotation.x=PI/2;m.add(core,ring);m.position.set(l*2.2,1.35,z);sc.add(m);pups.push({m,core,ring,x:l*2.2,id:q.id,name:q.name,col:q.col,dur:q.dur,ph:Math.random()*9})}
function spawnPower(z){
  const l=[-1,0,1][Math.random()*3|0];
  // Keep FLIGHT rare; normal power-ups are much more common.
  const r=Math.random();
  const i=r<.05?0:(r<.525?1:2);
  addPower(l,z,i);
}
function usePower(q){power=q.id;powerT=q.dur;$('pow').textContent=q.ic+' '+q.name+' · '+q.dur.toFixed(1)+'s';bn(q.name+'!');tone(620,.12,'triangle',.1,980);if(power=='fly'){py=Math.max(py,5.8);vy=0}}

function spawn(z){const gv=Math.random()*3|0,r=Math.random(),pk=a=>a[Math.random()*a.length|0],fr=a=>[-1,0,1].filter(l=>l!==a),a=pk([-1,0,1]),low=()=>pk(['log','gap']);
 const tl=(l,n,s,z0,h)=>{for(let i=0;i<n;i++)addTok(typeof l=='function'?l(i):l,z0-i*s,h?h(i,n):0,i,gv)};
 if(r<.2){addObs('block',a,z);tl(pk(fr(a)),7,3,z+9)}
 else if(r<.4){const f=fr(a),b=pk(f);addObs('block',a,z);addObs(low(),b,z);tl(f.find(l=>l!==b),7,3,z+9)}
 else if(r<.58){addObs(low(),a,z);tl(a,7,3,z+9,(i,n)=>1.4*Math.sin(PI*i/(n-1)))}
 else if(r<.72){addObs('beam',0,z);tl(a,5,3,z+16)}
 else if(r<.86){tl(i=>[-1,0,1,0][i%4],9,4,z+16);addObs('block',pk([-1,1]),z-26)}
 else tl(i=>Math.sin(i*.45)*1.1,12,3,z+16)}
function burst(x,y,z,n,c,vz,rd){for(let i=0;i<n;i++){const m=mk(gs.pb,c||mt.spark);m.position.set(x,y,z);sc.add(m);const a=Math.random()*PI*2;parts.push({m,v:new T.Vector3(Math.cos(a)*(c&&!rd?1.2:4),2+Math.random()*3,(c&&!rd?(vz||0):Math.sin(a)*4)),l:.5})}}
function bn(s){const e=$('bn');e.textContent=s;e.style.opacity=1;clearTimeout(bn.h);bn.h=setTimeout(()=>e.style.opacity=0,2400)}
// input
function act(a){if(st!='run')return;au();
 if(a=='L'&&lane>-1)lane--;else if(a=='R'&&lane<1)lane++;
 else if(a=='U'&&py<=.01){vy=power=='jump'?23:11.5;sJump();slideT=0}
 else if(a=='D'){if(py>.01){vy=-22;pend=1}else{slideT=.85;sSlide()}}}
function show(a,b,c,m){$('ot').textContent=a;$('op').textContent=b;$('ob').textContent=c;$('ov').classList.toggle('menu',!!m);$('lib').classList.toggle('hide',!m);$('ob2').classList.toggle('hide',!!m||a!='PAUSED');$('ov').classList.remove('hide')}
function openMenu(a,b,c){mn=1;st='ready';reset();show(a,b,c,1);sel()}
function go(){au();if(st=='over'||st=='ready')reset();st='run';mn=0;spin=Math.atan2(Math.sin(spin),Math.cos(spin));$('ov').classList.add('hide')}
function pause(){if(st=='run'){st='pause';show('PAUSED','Rest a moment, explorer.','RESUME')}else if(st=='pause')go()}
$('ob').onclick=go;$('ob2').onclick=()=>openMenu('ANCIENT RUNNER 3D','Choose your hero and your map.','BEGIN EXPEDITION');
addEventListener('keydown',e=>{const k=e.key.toLowerCase();if([' ','arrowup','arrowdown','arrowleft','arrowright'].includes(k))e.preventDefault();
 if(mn){const c=tab?mi:ci,n=tab?MAPS.length:CH.length;if(k=='arrowleft'||k=='a')pick((c+n-1)%n);else if(k=='arrowright'||k=='d')pick((c+1)%n);else if(k=='c'||k=='m'){tab=k=='m'?1:0;sel()}else if(k==' '||k=='enter')go();return}if(k=='p'||k=='escape'){pause();return}if(st!='run'){if(k==' '||k=='enter')go();return}
 if(k=='a'||k=='arrowleft')act('L');else if(k=='d'||k=='arrowright')act('R');else if(k=='w'||k=='arrowup'||k==' ')act('U');else if(k=='s'||k=='arrowdown')act('D')});
let tx,ty;addEventListener('touchstart',e=>{tx=e.touches[0].clientX;ty=e.touches[0].clientY},{passive:true});
addEventListener('touchend',e=>{if(tx==null)return;const dx=e.changedTouches[0].clientX-tx,dy=e.changedTouches[0].clientY-ty;tx=null;if(Math.max(Math.abs(dx),Math.abs(dy))<28)return;if(Math.abs(dx)>Math.abs(dy))act(dx<0?'L':'R');else act(dy<0?'U':'D')},{passive:true});
function die(){st='over';sHit();shake=.5;const s=Math.floor(dist);if(s>best){best=s;try{localStorage.setItem('ar_best',best)}catch(e){}}
 const msg='Level '+lvl+' · '+s+' m · Diamonds '+coins+' · Best '+best+' m';setTimeout(()=>{if(st=='over')openMenu('EXPEDITION OVER',msg,'TRY AGAIN')},800)}
function update(dt){
 const tg=Math.min(62,28+(lvl-1)*4);spd+=(tg-spd)*Math.min(1,dt*.7);const d=spd*dt;dist+=d;
 for(const g of groups){g.position.z+=d;if(g.position.z>8+SL){g.position.z-=N*SL;g.idx+=N;cfg(g)}}
 for(const o of obs)o.m.position.z+=d;for(const q of pups)q.m.position.z+=d;
 for(const k of toks){k.m.position.z+=d;k.g.rotation.y+=dt*3;k.g.position.y=.1+Math.sin(t*3+k.ph)*.08;k.s.scale.setScalar(.3+1.2*Math.pow(Math.max(0,Math.sin(t*5+k.ph*1.7)),6))}
 wtex.offset.y+=d/13;
 fly(dt,d);
 px+=(lane*2.2-px)*Math.min(1,dt*16);
 if(powerT>0){powerT-=dt;if(power=='fly'){py=5.8+Math.sin(t*5)*.25;vy=0;pend=0}if(powerT<=0){power='';powerT=0;$('pow').textContent=''}}
 if(power!='fly'&&(py>0||vy>0)){vy-=(power=='jump'?22:32)*dt;py+=vy*dt;if(py<=0){py=0;vy=0;if(pend){slideT=.85;pend=0;sSlide()}}}
 if(slideT>0)slideT-=dt;
 const sl=slideT>0&&py<.3,h=sl?.6:1.9;
 if(py<.02&&(dustT-=dt)<=0){dustT=.04;burst(px+(Math.random()-.5)*.5,.1,.4,1,mt.dust,spd*.8)}
 spawnD-=d;if(spawnD<=0){spawn(-190);spawnD=spd*1.2+16} pupD-=d;if(pupD<=0){spawnPower(-135-Math.random()*45);pupD=65+Math.random()*35}
 for(const o of obs)if(power!='fly'&&power!='invis'&&Math.abs(o.m.position.z)<o.hz+.35&&Math.abs(px-o.x)<o.hw+.35){if(o.t=='gap'?py<.2:(py<o.y1&&py+h>o.y0)){die();return}}
 for(let i=pups.length-1;i>=0;i--){const q=pups[i];q.core.rotation.x+=dt*3;q.core.rotation.y+=dt*4;q.ring.rotation.z+=dt*2;q.m.position.y=1.15+Math.sin(t*3+q.ph)*.14;if(q.m.position.z>12){sc.remove(q.m);pups.splice(i,1);continue}if(Math.abs(q.m.position.z)<1&&Math.abs(q.x-px)<1.2&&Math.abs(q.m.position.y-(py+.95))<1.3){usePower(q);burst(q.x,q.m.position.y,0,18,q.col,2,1);sc.remove(q.m);pups.splice(i,1)}}
 for(let i=toks.length-1;i>=0;i--){const k=toks[i];if(k.m.position.z>12){sc.remove(k.m);toks.splice(i,1);continue}
  if(Math.abs(k.m.position.z)<1&&Math.abs(k.x-px)<1&&Math.abs(k.m.position.y-(py+(sl?.4:.95)))<1.1){burst(k.m.position.x,k.m.position.y,0,12,k.v.sk,0,1);sc.remove(k.m);toks.splice(i,1);coins++;sCoin()}}
 for(let i=obs.length-1;i>=0;i--)if(obs[i].m.position.z>12){sc.remove(obs[i].m);obs.splice(i,1)}
