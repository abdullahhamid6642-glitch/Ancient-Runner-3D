 else if(ty=='gap'){const b=mk(gs.gap,mt.gap);b.position.y=.03;g.add(b);Object.assign(o,{hz:1.6})}
 else{const b=mk(gs.bar,mt.stone);b.position.y=1.875;g.add(b);for(const d of[-1,1]){const p=mk(gs.bpost,mt.stone);p.position.set(d*3.6,1.3,0);g.add(p)}for(let i=0;i<6;i++){const v=mk(gs.vine,mt.vine);v.position.set(-3.2+i*1.3,1.1,.3);g.add(v)}Object.assign(o,{x:0,hw:4,y0:1.35,y1:2.4,hz:.4})}
